# Copiar a infra/prod.env (está en .gitignore) y completar. Lo lee
# docker-compose.prod.yml con --env-file. Guía en docs/DEPLOY.md.

# Dominio base. El front queda en app.<DOMAIN> y la API en api.<DOMAIN>.
# Ejemplo con DuckDNS: DOMAIN=mihelpdesk.duckdns.org
DOMAIN=

# Contraseñas de Postgres. Van dentro de una URL de conexión: usar solo
# caracteres hexadecimales. Generar cada una con:  openssl rand -hex 24
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# Secretos JWT, distintos entre sí y de 32+ caracteres (ADR-0011).
# Generar cada uno con:  openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
