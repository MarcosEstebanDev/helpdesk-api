// Prisma schema — fuente de verdad del modelo relacional (ADR-0003 multi-tenancy
// con Row-Level Security row-level por `tenant_id`).
//
// Dos conexiones (ADR-0010):
//   - `url`       -> rol de aplicación RESTRINGIDO (sin BYPASSRLS, no dueño de las
//                    tablas). Lo usa @prisma/client en runtime. RLS SIEMPRE aplica.
//   - `directUrl` -> rol owner/superusuario, solo para `prisma migrate` (DDL).
//
// Las policies de RLS y el rol de app NO los modela Prisma: viven en el SQL de la
// migración (ver prisma/migrations/*/migration.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

/// Roles dentro de una organización. El rol es POR membership (por tenant),
/// nunca global (ver modelo de seguridad en CLAUDE.md).
enum Role {
  ADMIN
  AGENT
  VIEWER

  @@map("role")
}

/// Tenant raíz. Su aislamiento RLS se hace por `id` (es la propia clave de tenant),
/// a diferencia de las tablas hijas que se aíslan por `tenant_id`.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                      User[]
  memberships                Membership[]
  refreshTokens              RefreshToken[]
  tickets                    Ticket[]
  comments                   Comment[]
  auditLogs                  AuditLog[]
  ticketCounter              TicketCounter?
  outbox                     OutboxMessage[]
  processed                  ProcessedMessage[]
  slaPolicies                SlaPolicy[]
  slaTimers                  SlaTimer[]
  ticketTriages              TicketTriage[]
  cannedResponses            CannedResponse[]
  tags                       Tag[]
  ticketTags                 TicketTag[]
  savedViews                 SavedView[]
  businessCalendar           BusinessCalendar?
  businessCalendarExceptions BusinessCalendarException[]

  @@map("organizations")
}

/// Usuario perteneciente a un tenant. El email es único POR tenant (el mismo email
/// puede existir en organizaciones distintas).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization     Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships      Membership[]
  refreshTokens    RefreshToken[]
  requestedTickets Ticket[]       @relation("TicketRequester")
  assignedTickets  Ticket[]       @relation("TicketAssignee")
  comments         Comment[]

  @@unique([tenantId, email])
  @@map("users")
}

/// Relación usuario <-> organización con su rol. Un usuario tiene a lo sumo un
/// membership por tenant.
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("memberships")
}

/// Refresh token persistido (ADR-0011). Solo se guarda el HASH del JWT emitido:
/// el valor en claro vive únicamente en la cookie httpOnly del cliente.
///
/// `familyId` encadena los tokens sucesivos de una misma sesión: rotar marca
/// `rotatedAt` y emite el siguiente de la familia; presentar uno ya rotado o
/// revocado es reuse (indicio de robo) => se revoca la familia entera.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  rotatedAt DateTime? @map("rotated_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Lookup por hash dentro del tenant (findByHash) y revocación por familia.
  @@index([tenantId, tokenHash])
  @@index([tenantId, familyId])
  @@map("refresh_tokens")
}

/// Estados de un ticket (ADR-0015). El enum aquí es solo la forma de la columna;
/// las TRANSICIONES válidas viven en el dominio (`ticket-status.ts`), porque son
/// una regla de negocio y no una restricción de almacenamiento.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("ticket_priority")
}

/// Ticket de soporte. `number` es el identificador VISIBLE (#1042), correlativo
/// por organización (ADR-0017); el `id` UUID sigue siendo la clave primaria y lo
/// que viaja por la API, para no exponer el volumen de tickets de un tenant.
///
/// `updated_at` NO usa `@updatedAt`: lo fija el dominio a partir del puerto
/// `Clock`. Si lo gestionara Prisma, el timestamp de la entidad en memoria y el
/// de la fila divergirían, y los tests dejarían de ser deterministas.
model Ticket {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  number      Int
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  requesterId String         @map("requester_id") @db.Uuid
  assigneeId  String?        @map("assignee_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @map("updated_at")
  resolvedAt  DateTime?      @map("resolved_at")
  closedAt    DateTime?      @map("closed_at")

  organization Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester    User          @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments     Comment[]
  slaTimers    SlaTimer[]
  triage       TicketTriage?

  // El número es único DENTRO del tenant, nunca global.
  tags TicketTag[]

  /// Búsqueda (ADR-0032): columna GENERADA por Postgres; Prisma no la escribe.
  searchVector Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('spanish'::regconfig, helpdesk_unaccent(COALESCE(subject, ''::text))), 'A'::\"char\") || setweight(to_tsvector('spanish'::regconfig, helpdesk_unaccent(COALESCE(description, ''::text))), 'B'::\"char\"))")) @map("search_vector")

  @@unique([tenantId, number])
  // Listado por defecto: filtrar por estado dentro del tenant, más reciente primero.
  @@index([tenantId, status, createdAt])
  // "Mis tickets": bandeja de un agente.
  @@index([tenantId, assigneeId, status])
  @@index([searchVector], type: Gin)
  @@map("tickets")
}

/// Respuesta al cliente o nota del equipo (ADR-0028). El cliente (VIEWER) no
/// ve las INTERNAL; hoy lo garantiza el read model, no una policy de RLS.
enum CommentVisibility {
  PUBLIC
  INTERNAL

  @@map("comment_visibility")
}

/// Comentario en un ticket. Parte del agregado Ticket a efectos de negocio, pero
/// tabla propia: una conversación crece sin límite y no tiene sentido cargarla
/// entera cada vez que se toca el ticket.
model Comment {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  ticketId   String            @map("ticket_id") @db.Uuid
  authorId   String            @map("author_id") @db.Uuid
  body       String
  visibility CommentVisibility @default(PUBLIC)
  createdAt  DateTime          @default(now()) @map("created_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// Búsqueda (ADR-0032): columna GENERADA por Postgres; Prisma no la escribe.
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('spanish'::regconfig, helpdesk_unaccent(COALESCE(body, ''::text)))")) @map("search_vector")

  @@index([tenantId, ticketId, createdAt])
  @@index([searchVector], type: Gin)
  @@map("comments")
}

/// Rastro de auditoría. Se escribe en la MISMA transacción que el cambio que
/// registra (ADR-0016), así que no existe un estado en el que el cambio esté
/// guardado y su auditoría no.
///
/// `entityId` es UUID pero SIN foreign key a propósito: la auditoría debe
/// sobrevivir al borrado de lo que audita. Una FK con ON DELETE CASCADE borraría
/// justo la evidencia de que algo se borró.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json?
  occurredAt DateTime @map("occurred_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Historial de UNA entidad concreta ("¿qué le pasó a este ticket?").
  @@index([tenantId, entityType, entityId, occurredAt])
  // Actividad reciente del tenant.
  @@index([tenantId, occurredAt])
  @@map("audit_logs")
}

/// Contador de numeración visible, una fila por organización (ADR-0017).
///
/// Tabla propia y no una SEQUENCE de Postgres: una secuencia es global y no
/// transaccional (un rollback deja hueco), y crear una por tenant significa DDL
/// en tiempo de ejecución. Con una fila y `SELECT ... FOR UPDATE` dentro de la
/// transacción del ticket, la numeración es correlativa y sin huecos.
model TicketCounter {
  tenantId   String @id @map("tenant_id") @db.Uuid
  nextNumber Int    @default(1) @map("next_number")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ticket_counters")
}

/// Outbox transaccional (ADR-0007 / ADR-0018). Cada fila es un evento de
/// integración escrito en la MISMA transacción que el cambio que lo produjo, de
/// modo que no puede existir un cambio cuyo evento se perdió ni un evento que
/// anuncie algo que se revirtió.
///
/// `payload` guarda el estado relevante EN EL MOMENTO del evento (eventos
/// "gordos") y `version` versiona su forma: un consumidor que reciba una versión
/// que no conoce debe poder rechazarla en vez de malinterpretarla.
///
/// `attempts` y `last_error` los usa el publicador de la fase 5b para no
/// reintentar en bucle un mensaje envenenado.
model OutboxMessage {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventName     String    @map("event_name")
  version       Int
  payload       Json
  occurredAt    DateTime  @map("occurred_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  /// Correlación con la petición HTTP que originó el evento (ADR-0024). Nullable:
  /// lo escrito antes de esa fase, y lo que nace fuera de una request (el barrido
  /// de SLA), no lo tiene.
  requestId     String?   @map("request_id")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Consulta del publicador: pendientes, más antiguos primero. Sería mejor un
  // índice PARCIAL (`WHERE published_at IS NULL`), que se mantendría pequeño
  // porque las filas salen de él al publicarse; se usa uno normal porque Prisma
  // no los modela y declararlo solo en el SQL haría que `migrate diff` viera
  // drift permanente contra el schema.
  @@index([publishedAt, occurredAt])
  // Historial de eventos de un agregado concreto.
  @@index([tenantId, aggregateType, aggregateId, occurredAt])
  @@map("outbox_messages")
}

/// Registro de lo ya procesado por cada consumidor (ADR-0019).
///
/// La entrega desde una cola es AT-LEAST-ONCE: el mismo evento puede llegar dos
/// veces (el publicador reintentó, el worker murió tras hacer el trabajo pero
/// antes de confirmar...). La clave primaria compuesta es la garantía: el
/// consumidor la inserta en la MISMA transacción que su efecto, así que el
/// segundo intento choca contra ella y no repite nada.
///
/// La clave es (consumer, event_id) y no solo `event_id` porque varios
/// consumidores distintos deben poder procesar el mismo evento cada uno una vez.
model ProcessedMessage {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([consumer, eventId])
  @@map("processed_messages")
}

/// Los dos relojes que corren sobre un ticket (ADR-0020).
enum SlaKind {
  RESPONSE
  RESOLUTION

  @@map("sla_kind")
}

/// Objetivos de SLA que una organización sobreescribe (ADR-0020).
///
/// Solo se guardan las prioridades que el tenant quiera cambiar: las que falten
/// se completan con `DEFAULT_SLA_POLICY`, que vive en el DOMINIO. Así una
/// organización creada antes de esta fase —o que nunca configuró nada— tiene SLA
/// igualmente, y `iam` no necesita saber que el SLA existe para sembrar filas.
model SlaPolicy {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  priority          TicketPriority
  responseMinutes   Int            @map("response_minutes")
  resolutionMinutes Int            @map("resolution_minutes")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, priority])
  @@map("sla_policies")
}

/// Reloj de SLA de un ticket (ADR-0021).
///
/// El estado NO se guarda como un campo: se DERIVA de las fechas. Corriendo =
/// `stopped_at IS NULL AND breached_at IS NULL`; parado a tiempo = `stopped_at`;
/// incumplido = `breached_at`. Un campo `status` aparte podría contradecirlas.
///
/// `due_at` se calcula al arrancar y se persiste: si el tenant cambia su política
/// después, los relojes ya en marcha conservan el objetivo con el que nacieron.
model SlaTimer {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  ticketId   String    @map("ticket_id") @db.Uuid
  kind       SlaKind
  startedAt  DateTime  @map("started_at")
  dueAt      DateTime  @map("due_at")
  stoppedAt  DateTime? @map("stopped_at")
  breachedAt DateTime? @map("breached_at")
  // En pausa mientras el ticket espera al cliente (ADR-0029). El barrido ignora
  // los pausados; ver `sla_due_timers` en la migración 20261112120000.
  pausedAt   DateTime? @map("paused_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Un ticket tiene como mucho un reloj de cada tipo. La restricción es la
  // garantía de idempotencia al arrancarlos: un evento reprocesado choca aquí.
  @@unique([ticketId, kind])
  // Consulta del barrido: los que vencen antes de ahora. Sería mejor un índice
  // parcial (`WHERE stopped_at IS NULL AND breached_at IS NULL`), pero Prisma no
  // los modela y declararlo solo en SQL produciría drift permanente.
  @@index([dueAt])
  @@index([tenantId, ticketId])
  @@map("sla_timers")
}

/// Sugerencia de triage de la IA para un ticket (ADR-0027).
///
/// Tabla aparte y NO columnas en `tickets`: la IA sugiere, no decide. La
/// prioridad real del ticket (y con ella los relojes de SLA) solo la cambia una
/// persona; aquí queda lo que el modelo propuso, para mostrarlo y, más adelante,
/// medir cuánto acierta contra lo que el agente terminó eligiendo.
///
/// `ticket_id` es la clave primaria: como mucho una sugerencia por ticket, y esa
/// restricción es también la garantía de idempotencia al guardarla.
///
/// `category`, `sentiment` y `language` son texto y no enums de Postgres: la
/// lista la valida el dominio, y cambiarla no debería exigir una migración que
/// bloquee la tabla. `model` y `prompt_version` permiten comparar sugerencias
/// por su origen.
model TicketTriage {
  ticketId          String         @id @map("ticket_id") @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  category          String
  suggestedPriority TicketPriority @map("suggested_priority")
  sentiment         String
  language          String
  provider          String
  model             String
  promptVersion     String         @map("prompt_version")
  latencyMs         Int            @map("latency_ms")
  inputTokens       Int?           @map("input_tokens")
  outputTokens      Int?           @map("output_tokens")
  triagedAt         DateTime       @map("triaged_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Métricas por categoría dentro del tenant.
  @@index([tenantId, category])
  @@map("ticket_triages")
}

/// Respuesta predefinida de la organización (ADR-0030). Solo texto: insertarla
/// no cambia nada del ticket. `title_key` es el título recortado y en
/// minúsculas, para que la unicidad no distinga mayúsculas sin un índice de
/// expresión (que Prisma no modela y daría drift).
model CannedResponse {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String
  titleKey  String   @map("title_key")
  body      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Unicidad del título por tenant; su btree además sirve el listado ordenado.
  @@unique([tenantId, titleKey])
  @@map("canned_responses")
}

/// Etiqueta del catálogo de la organización (ADR-0031). `name_key` = nombre
/// recortado y en minúsculas, para la unicidad sin índice de expresión.
model Tag {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  nameKey   String   @map("name_key")
  color     String
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets      TicketTag[]

  @@unique([tenantId, nameKey])
  @@map("tags")
}

/// Qué etiquetas tiene cada ticket (ADR-0031). Lleva `tenant_id` propio para
/// que la policy de RLS sea la misma que en el resto del esquema.
model TicketTag {
  ticketId String @map("ticket_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  // El filtro de la bandeja va de la etiqueta a sus tickets.
  @@index([tenantId, tagId])
  @@map("ticket_tags")
}

/// Vista guardada de la bandeja (ADR-0033). `owner_id` null = compartida (solo
/// un ADMIN la escribe). `scope_key` = 'shared' o el id del dueño: Postgres no
/// trata los NULL como iguales en un índice único, así que la unicidad del
/// nombre por ámbito necesita una columna sin NULL.
model SavedView {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ownerId   String?  @map("owner_id") @db.Uuid
  scopeKey  String   @map("scope_key")
  name      String
  nameKey   String   @map("name_key")
  filters   Json
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scopeKey, nameKey])
  @@map("saved_views")
}

/// Horario laboral (ADR-0034). Sin fila = valores por defecto del dominio
/// (L–V 08:00–18:00, Argentina): no hay backfill para las organizaciones.
enum BusinessCalendarMode {
  BUSINESS_HOURS
  TWENTY_FOUR_SEVEN
}

model BusinessCalendar {
  tenantId       String               @id @map("tenant_id") @db.Uuid
  mode           BusinessCalendarMode
  timeZone       String               @map("time_zone")
  /// Días ISO (1 = lunes … 7 = domingo).
  weekdays       Int[]                @db.SmallInt
  opensAtMinute  Int                  @map("opens_at_minute") @db.SmallInt
  closesAtMinute Int                  @map("closes_at_minute") @db.SmallInt
  updatedAt      DateTime             @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_calendars")
}

model BusinessCalendarException {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Fecha LOCAL de la organización.
  date      DateTime @db.Date
  working   Boolean
  name      String
  createdAt DateTime @map("created_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("business_calendar_exceptions")
}
