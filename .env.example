# Copy to .env and fill in. Validated at boot by src/infrastructure/config/env.schema.ts
NODE_ENV=development
PORT=3000

# Postgres (Phase 2+). Dos conexiones por la estrategia RLS (ADR-0010):
#   - DATABASE_URL: rol de APLICACIÓN restringido (sin BYPASSRLS). Lo usa la app.
#   - MIGRATION_DATABASE_URL: rol owner/superusuario, SOLO para `prisma migrate`.
DATABASE_URL=postgresql://helpdesk_app:helpdesk_app@localhost:5432/helpdesk?schema=public
MIGRATION_DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public

# Required from Phase 5 (BullMQ + Redis)
REDIS_URL=redis://localhost:6379

# Workers en proceso (ADR-0019 / ADR-0021). Todo esto tiene default, así que solo
# hace falta declararlo para cambiarlo.
#   WORKER_ENABLED=0 arranca la API sin publicador de outbox, sin consumidores de
#   cola y sin barrido de SLA. Es lo que permitirá separar mañana el despliegue de
#   workers del de la API sin tocar código (y lo que usan los tests e2e).
# WORKER_ENABLED=1
# OUTBOX_POLL_INTERVAL_MS=1000
# Intervalo del barrido de SLA: fija la PRECISIÓN con la que se detecta un
# incumplimiento. Con objetivos medidos en horas, 30s sobra.
# SLA_SWEEP_INTERVAL_MS=30000
# SLA_SWEEP_BATCH_SIZE=100

# Secretos JWT (ADR-0011). Dos distintos a propósito: un access token filtrado
# no debe permitir forjar refresh tokens. Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambiame-por-un-secreto-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=cambiame-por-otro-secreto-distinto-de-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Orígenes del navegador autorizados (separados por coma). El front manda la
# cookie httpOnly del refresh, y con credenciales el navegador NO acepta el
# comodín `*`: hay que enumerar los orígenes exactos.
# CORS_ORIGINS=http://localhost:3001

# Observabilidad (ADR-0024). Nivel de log: en produccion `info`, porque `debug`
# en un sistema con colas escupe una linea por job y ahoga lo que importa.
# LOG_LEVEL=info
